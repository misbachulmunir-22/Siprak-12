# Konfigurasi Environment Siprak-12 Sprint 2 (Lampiran C.1 SRS)
# Salin berkas ini menjadi .env dan isi dengan konfigurasi Firebase Project tim.

EXPO_PUBLIC_FIREBASE_API_KEY=isi_dari_firebase_project
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=isi_dari_firebase_project
EXPO_PUBLIC_FIREBASE_PROJECT_ID=isi_dari_firebase_project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=isi_dari_firebase_project
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=isi_dari_firebase_project
EXPO_PUBLIC_FIREBASE_APP_ID=isi_dari_firebase_project
EXPO_PUBLIC_AI_API_BASE_URL=URL_RESMI_DARI_PENGAJAR

# Jangan memasukkan private API secret ke EXPO_PUBLIC_*.
# Secret bersama harus disimpan pada backend/proxy tepercaya.
