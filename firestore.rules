rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasMyProfile() {
      return signedIn() && exists(myProfilePath());
    }

    function myProfile() {
      return get(myProfilePath()).data;
    }

    function activeUser() {
      return hasMyProfile() && myProfile().active == true;
    }

    function isAssistant() {
      return activeUser() && myProfile().role == 'asisten';
    }

    function isPraktikan() {
      return activeUser() && myProfile().role == 'praktikan';
    }

    function assistantFor(classId) {
      return isAssistant()
        && exists(/databases/$(database)/documents/classes/$(classId))
        && request.auth.uid in get(
          /databases/$(database)/documents/classes/$(classId)
        ).data.assistantUids;
    }

    function memberOf(classId) {
      return isPraktikan()
        && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid))
        && get(
          /databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)
        ).data.active == true;
    }

    function canAccessClass(classId) {
      return assistantFor(classId) || memberOf(classId);
    }

    function sessionExists(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId));
    }

    function sessionData(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    // -----------------------------------------------------------------------
    // users/{uid}: FR-S2-01..04
    // -----------------------------------------------------------------------
    match /users/{uid} {
      // get spesifik diperbolehkan untuk pemilik. Asisten dapat membaca profil
      // praktikan berdasarkan UID yang diketahui untuk proses pemetaan peserta.
      // list tetap ditutup agar seluruh data profil tidak dapat dienumerasi.
      allow get: if signedIn() && (
        request.auth.uid == uid ||
        (isAssistant() && resource.data.role == 'praktikan')
      );
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'nama', 'email', 'role', 'nim', 'kelasIds',
          'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'nama', 'email', 'role', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'praktikan'
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (!('nim' in request.resource.data)
          || request.resource.data.nim is string);

      // Pemilik hanya boleh mengubah nama/NIM. Role dan active hanya boleh
      // diubah lewat proses administrasi tepercaya.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nama', 'nim', 'updatedAt'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() >= 3
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // classes/{classId} dan members: FR-S2-05..07
    // -----------------------------------------------------------------------
    match /classes/{classId} {
      allow get, list: if canAccessClass(classId);

      allow create: if isAssistant()
        && request.resource.data.keys().hasAll([
          'nama', 'kode', 'namaPraktikum', 'assistantUids', 'active'
        ])
        && request.resource.data.assistantUids is list
        && request.auth.uid in request.resource.data.assistantUids
        && request.resource.data.active == true;

      allow update: if assistantFor(classId)
        && request.resource.data.assistantUids == resource.data.assistantUids
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nama', 'kode', 'namaPraktikum', 'active', 'updatedAt']);

      // Arsipkan kelas dengan active=false agar riwayat tetap utuh.
      allow delete: if false;

      match /members/{uid} {
        allow get, list: if signedIn() && (
          request.auth.uid == uid || assistantFor(classId)
        );

        allow create: if assistantFor(classId)
          && request.resource.data.uid == uid
          && request.resource.data.active == true
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.role == 'praktikan'
          && get(/databases/$(database)/documents/users/$(uid)).data.active == true;

        allow update: if assistantFor(classId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['namaSnapshot', 'nimSnapshot', 'active']);

        // Gunakan active=false untuk mengeluarkan anggota dari kelas.
        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // schedules/{scheduleId}: FR-S2-08..09
    // -----------------------------------------------------------------------
    match /schedules/{scheduleId} {
      allow get, list: if canAccessClass(resource.data.classId);

      allow create: if assistantFor(request.resource.data.classId)
        && request.resource.data.pertemuan is int
        && request.resource.data.pertemuan >= 1
        && request.resource.data.jamMulai is string
        && request.resource.data.jamSelesai is string
        && request.resource.data.tanggal is string;

      allow update: if assistantFor(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'namaPraktikum', 'pertemuan', 'lab', 'tanggal',
            'jamMulai', 'jamSelesai', 'active', 'updatedAt'
          ]);

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // sessions/{sessionId}: FR-S2-08..10, FR-S2-13
    // -----------------------------------------------------------------------
    match /sessions/{sessionId} {
      allow get, list: if canAccessClass(resource.data.classId);

      allow create: if assistantFor(request.resource.data.classId)
        && request.resource.data.status == 'belum_dibuka'
        && request.resource.data.pertemuan is int
        && request.resource.data.pertemuan >= 1
        && request.resource.data.scheduleId is string;

      // Status sesi hanya boleh bergerak:
      // belum_dibuka -> dibuka -> ditutup. Sesi ditutup bersifat final.
      allow update: if assistantFor(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status', 'dibukaPada', 'ditutupPada',
            'catatanPenutup', 'updatedAt', 'active'
          ])
        && (
          request.resource.data.status == resource.data.status ||
          (
            resource.data.status == 'belum_dibuka'
            && request.resource.data.status == 'dibuka'
            && request.resource.data.dibukaPada == request.time
          ) ||
          (
            resource.data.status == 'dibuka'
            && request.resource.data.status == 'ditutup'
            && request.resource.data.ditutupPada == request.time
          )
        );

      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // attendances/{sessionId_uid}: FR-S2-11..15
    // -----------------------------------------------------------------------
    match /attendances/{attendanceId} {
      allow get, list: if signedIn() && (
        resource.data.praktikanUid == request.auth.uid ||
        assistantFor(resource.data.classId)
      );

      // ID deterministik mencegah presensi ganda bahkan dari dua perangkat.
      allow create: if isPraktikan()
        && request.resource.data.praktikanUid == request.auth.uid
        && request.resource.data.sessionId is string
        && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
        && memberOf(request.resource.data.classId)
        && sessionExists(request.resource.data.sessionId)
        && sessionData(request.resource.data.sessionId).classId == request.resource.data.classId
        && sessionData(request.resource.data.sessionId).status == 'dibuka'
        && request.resource.data.waktuHadir == request.time
        && request.resource.data.keys().hasOnly([
          'sessionId', 'classId', 'praktikanUid', 'waktuHadir', 'createdAt'
        ]);

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // leaveRequests/{requestId}: FR-S2-16..20
    // -----------------------------------------------------------------------
    match /leaveRequests/{requestId} {
      allow get, list: if signedIn() && (
        resource.data.praktikanUid == request.auth.uid ||
        assistantFor(resource.data.classId)
      );

      allow create: if isPraktikan()
        && request.resource.data.praktikanUid == request.auth.uid
        && request.resource.data.sessionId is string
        && memberOf(request.resource.data.classId)
        && sessionExists(request.resource.data.sessionId)
        && sessionData(request.resource.data.sessionId).classId == request.resource.data.classId
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() > 0
        && request.resource.data.status == 'menunggu'
        && request.resource.data.aiStatus == 'menunggu'
        // ID deterministik membatasi satu pengajuan aktif per sesi/pemohon.
        && requestId == request.resource.data.sessionId + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/leaveRequests/$(requestId))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.keys().hasOnly([
          'sessionId', 'classId', 'praktikanUid', 'alasan',
          'aiStatus', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == request.time;

      // Pemohon hanya memperbarui metadata klasifikasi AI, bukan keputusan.
      allow update: if signedIn()
        && isPraktikan()
        && resource.data.praktikanUid == request.auth.uid
        && resource.data.status == 'menunggu'
        && request.resource.data.status == resource.data.status
        && !('reviewerUid' in request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'aiStatus', 'aiCategory', 'aiConfidence',
            'aiModel', 'aiProcessedAt', 'updatedAt'
          ])
        && request.resource.data.aiStatus in [
          'berhasil', 'gagal', 'tidak_tersedia'
        ]
        && request.resource.data.updatedAt == request.time
        && request.resource.data.aiProcessedAt == request.time
        && (
          request.resource.data.aiStatus != 'berhasil' ||
          (
            request.resource.data.aiCategory is string
            && request.resource.data.aiCategory.size() > 0
          )
        );

      // Pengajuan yang sebelumnya ditolak boleh diajukan ulang oleh pemilik
      // dengan ID deterministik yang sama. Semua metadata hasil/reviewer direset.
      allow update: if isPraktikan()
        && resource.data.praktikanUid == request.auth.uid
        && resource.data.status == 'ditolak'
        && request.resource.data.status == 'menunggu'
        && request.resource.data.aiStatus == 'menunggu'
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.praktikanUid == resource.data.praktikanUid
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() > 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'alasan', 'status', 'aiStatus', 'aiCategory', 'aiConfidence',
            'aiModel', 'aiProcessedAt', 'reviewerUid', 'reviewedAt',
            'reviewNote', 'updatedAt'
          ]);

      // Hanya asisten yang ditugaskan pada kelas terkait yang dapat mengambil
      // keputusan. Prediksi AI tidak pernah mengubah status keputusan.
      allow update: if assistantFor(resource.data.classId)
        && resource.data.status == 'menunggu'
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.praktikanUid == resource.data.praktikanUid
        && request.resource.data.status in ['disetujui', 'ditolak']
        && request.resource.data.reviewerUid == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewerUid', 'reviewedAt', 'reviewNote', 'updatedAt']);

      allow delete: if false;
    }

    // Deny-by-default untuk koleksi lain yang belum masuk kontrak Sprint 2.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
