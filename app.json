{
  "expo": {
    "name": "SIPRAK",
    "slug": "SIPRAK",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "siprak",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.undip.siprak",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SIPRAK menggunakan lokasi saat presensi untuk memastikan kamu berada di laboratorium."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "siprak",
          "color": "#173F7A"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SIPRAK menggunakan kamera untuk memindai QR presensi.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "edcf51b6-41d6-4ab0-a3d1-5cae5cf1a127"
      }
    },
    "owner": "haritsprmn"
  }
}
